#!/bin/sh
set -eu

scan_required=false

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/stable)
      scan_required=true
      ;;
  esac
done

if [ "$scan_required" = true ]; then
  echo "Verifying the mandatory local staged-release security receipt..."
  if ! bun run release:local verify-push; then
    echo "No current local release receipt was available; running the full security preflight..."
    bun run security:container
  fi
fi
