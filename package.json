{
  "name": "homelab-inventory",
  "private": true,
  "description": "Self-hosted visual inventory and cabling workbench for homelab hardware.",
  "version": "0.16.11",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mriverodorta/homelab-inventory.git"
  },
  "bugs": {
    "url": "https://github.com/mriverodorta/homelab-inventory/issues"
  },
  "homepage": "https://github.com/mriverodorta/homelab-inventory#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "ip-address": "10.4.0",
    "qs": "6.16.0"
  },
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.mjs",
    "prepare:release-artifacts": "bun scripts/release-artifacts/prepare.mjs",
    "prepare:agent": "bun scripts/prepare-agent-release.mjs",
    "check:agent-release": "bun scripts/check-agent-release-pin.mjs",
    "check:wasm": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "ci:verify": "bun scripts/ci/run.mjs",
    "ci:verify-receipt": "bun scripts/ci/verify-receipt.mjs",
    "predev": "bun run prepare:agent",
    "dev": "bun scripts/dev-wasm.mjs",
    "dev:server": "bun server/index.mjs",
    "dev:wasm": "bun scripts/dev-wasm.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "bun scripts/check-frontend-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrations:check": "bun scripts/check-database-migrations.mjs",
    "hooks:install": "bun scripts/install-git-hooks.mjs",
    "security:container": "bun scripts/check-container-security.mjs",
    "release:local": "bun scripts/local-release.mjs",
    "benchmark:engine": "bun scripts/benchmark-engine.mjs",
    "benchmark:sqlite": "bun scripts/benchmark-sqlite-persistence.mjs",
    "lint": "oxlint",
    "prebuild": "bun run build:wasm",
    "preview": "vite preview",
    "pretest": "bun run build:wasm",
    "release-notes:check": "bun scripts/check-release-notes.mjs",
    "packages:public:check": "bun scripts/check-share-packages.mjs",
    "packages:share:check": "bun scripts/check-share-packages.mjs",
    "sharing:integration:check": "bun scripts/sharing/verify-contract-readiness.mjs",
    "sharing:publication-preflight": "bun scripts/sharing/publication-preflight.mjs",
    "start": "NODE_ENV=production bun server/index.mjs",
    "auth:reset-owner": "bun server/auth/reset-owner-cli.mjs",
    "test": "bun scripts/ci/test-supervisor.mjs",
    "test:vitest": "NODE_OPTIONS=--no-experimental-webstorage vitest run --maxWorkers=8",
    "test:bun": "bun run test:auth && bun run test:sqlite",
    "test:auth": "bun test server/auth/*.bun_spec.mjs",
    "test:sqlite": "bun test scripts/verify-sqlite-runtime.bun_spec.mjs scripts/check-database-migrations.bun_spec.mjs scripts/benchmark-sqlite-persistence.bun_spec.mjs scripts/ci/*.bun_spec.mjs scripts/container-security/*.bun_spec.mjs scripts/local-release/*.bun_spec.mjs server/backup/sharing-identity-restore.bun_spec.ts server/persistence server/registry/*.bun_spec.mjs server/telemetry/*.bun_spec.mjs",
    "test:bundle": "bun test scripts/check-frontend-bundle.bun_spec.mjs",
    "test:public-packages": "NODE_OPTIONS=--no-experimental-webstorage vitest run packages/catalog-protocol packages/share-contract packages/viewer-model packages/viewer-react scripts/check-share-packages.test.mjs",
    "test:share-packages": "NODE_OPTIONS=--no-experimental-webstorage vitest run packages/share-contract packages/viewer-model packages/viewer-react scripts/check-share-packages.test.mjs",
    "benchmark:catalog-startup": "bun scripts/benchmark-catalog-startup.mjs",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.2",
    "casbin": "5.51.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "lowdb": "^7.0.1",
    "lru-cache": "11.5.2",
    "lucide-react": "^1.28.0",
    "openid-client": "^6.8.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
