{
  "name": "homelab-inventory",
  "private": true,
  "description": "Self-hosted visual inventory and cabling workbench for homelab hardware.",
  "version": "0.11.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mriverodorta/homelab-inventory.git"
  },
  "bugs": {
    "url": "https://github.com/mriverodorta/homelab-inventory/issues"
  },
  "homepage": "https://github.com/mriverodorta/homelab-inventory#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "ip-address": "10.4.0"
  },
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.mjs",
    "prepare:agent": "bun scripts/prepare-agent-release.mjs",
    "check:agent-release": "bun scripts/check-agent-release-pin.mjs",
    "check:wasm": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "predev": "bun run prepare:agent",
    "dev": "bun scripts/dev-wasm.mjs",
    "dev:server": "bun server/index.mjs",
    "dev:wasm": "bun scripts/dev-wasm.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "bun scripts/check-frontend-bundle.mjs",
    "hooks:install": "bun scripts/install-git-hooks.mjs",
    "security:container": "bun scripts/check-container-security.mjs",
    "benchmark:engine": "bun scripts/benchmark-engine.mjs",
    "lint": "oxlint",
    "prebuild": "bun run build:wasm",
    "preview": "vite preview",
    "pretest": "bun run build:wasm",
    "release-notes:check": "bun scripts/check-release-notes.mjs",
    "start": "NODE_ENV=production bun server/index.mjs",
    "auth:reset-owner": "bun server/auth/reset-owner-cli.mjs",
    "test": "vitest run && bun run test:auth && bun run test:sqlite",
    "test:auth": "bun test server/auth/*.bun_spec.mjs",
    "test:sqlite": "bun test scripts/verify-sqlite-runtime.bun_spec.mjs server/registry/*.bun_spec.mjs server/telemetry/*.bun_spec.mjs",
    "test:bundle": "bun test scripts/check-frontend-bundle.bun_spec.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "casbin": "5.51.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.28.0",
    "openid-client": "^6.8.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
