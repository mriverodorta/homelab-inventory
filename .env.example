# Optional overrides. The Docker image already defaults to these values.
NODE_ENV=production
PORT=8798
DATA_DIR=/data
SAVE_DEBOUNCE_MS=500

# Runtime mode: production app behavior or public demo sandbox behavior.
# Use NODE_ENV=production with APP_MODE=demo in Docker.
APP_MODE=production

# Anonymous Docker Hub update checks. Set latest for main-channel images,
# or false to disable all outbound update-check requests.
UPDATE_CHANNEL=stable
UPDATE_CHECK_ENABLED=true

# Connected catalog refresh interval. Set to 0 to keep manual refresh only.
REGISTRY_REFRESH_INTERVAL_MS=21600000

# Production installations enroll with lab.gd automatically without publishing
# any project data. Set false before first startup to prevent identity creation
# and all lab.gd traffic. Demo and staging modes always disable sharing.
LABGD_ENABLED=true
LABGD_ORIGIN=https://lab.gd

# Scheduled backups use TZ when it is set; otherwise select an IANA timezone
# from Settings > Backup & Restore. Scheduled stored backups use this optional
# passphrase. It must contain at least 12 characters when configured.
TZ=UTC
BACKUP_ENCRYPTION_PASSPHRASE=

# Optional owner-authentication bootstrap and OIDC overrides. Fresh production
# installations require one-time owner setup. When no bootstrap code is set,
# the generated code is printed once in the container log. *_FILE takes
# precedence over the matching inline value.
AUTH_BOOTSTRAP_CODE=
AUTH_BOOTSTRAP_CODE_FILE=
AUTH_EXTERNAL_URL=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=

# Demo mode only.
DEMO_SOURCE_DIR=/read-only-data
DEMO_SESSION_MINUTES=30
DEMO_MAX_SESSIONS=100

# Development note:
# bun run dev uses local ./data and can seed fictional sample data when empty.
